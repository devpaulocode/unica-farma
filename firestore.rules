rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == "devpaulocode@gmail.com";
    }

    // Contact messages: Anyone can create, only admin can read
    match /messages/{messageId} {
      allow create: if true; // Public contact form
      allow read: if isAdmin();
    }

    // Marketing assets: Only authenticated staff can read/write
    match /assets/{assetId} {
      allow read, write: if isAuthenticated();
    }
  }
}
