{
  "entities": {
    "ContactMessage": {
      "title": "Contact Message",
      "description": "Messages sent from the contact form",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "message", "createdAt"]
    },
    "MarketingAsset": {
      "title": "Marketing Asset",
      "description": "Images generated by AI for marketing",
      "type": "object",
      "properties": {
        "prompt": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["prompt", "imageUrl", "createdBy", "createdAt"]
    }
  },
  "firestore": {
    "/messages": {
      "schema": "ContactMessage",
      "description": "Collection of contact form messages"
    },
    "/assets": {
      "schema": "MarketingAsset",
      "description": "Collection of AI-generated marketing assets"
    }
  }
}
